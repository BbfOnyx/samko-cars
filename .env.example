# Django Settings
SECRET_KEY=change-me-to-a-super-secret-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database URL
# In local development, leave empty to default to SQLite.
# On Render, set this to the Internal Database URL provided by Render PostgreSQL.
# Example: postgresql://samko_db_user:password@dpg-xxxxxx-a.oregon-postgres.render.com/samko_db
DATABASE_URL=

# CSRF Trusted Origins (comma-separated, include https://)
# On Render: https://samko-cars.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Set True only when serving committed/local media through Django.
# Render's local disk is not durable for admin-uploaded files.
SERVE_MEDIA=False

# Optional persistent S3-compatible media storage for production uploads.
# Set all required credentials on Render; leave AWS_STORAGE_BUCKET_NAME empty locally.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_LOCATION=media

# Email configuration (Optional, for enquiry & purchase notification alerts)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Samko Cars <noreply@samkocars.com>
ADMIN_EMAIL=admin@samkocars.com
